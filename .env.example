# Copy to .env. Never commit .env.
# Encrypts every credential n8n stores (Notion, Google). Keep a copy in the family password
# manager: without it, the saved credentials can't be recovered after a restore.
N8N_ENCRYPTION_KEY=
# Required. The exact n8n version the workflows were tested on, e.g. 2.3.1. Find it with:
#   docker compose exec n8n n8n --version
# docker compose refuses to start while this is empty, so an update never happens by surprise.
N8N_VERSION=
